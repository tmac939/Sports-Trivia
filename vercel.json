{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/logo.png", "destination": "/api/logo.js" },
    { "source": "/icon-192.png", "destination": "/api/icon-192.js" },
    { "source": "/icon-512.png", "destination": "/api/icon-512.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
